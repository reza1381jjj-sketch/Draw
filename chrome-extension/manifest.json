{
  "manifest_version": 3,
  "name": "Real Quality Image Saver",
  "version": "1.0.0",
  "description": "Finds and downloads the original, full-resolution version of images on any site — not the resized thumbnail the page displays.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Real Quality Image Saver",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "100"
}
